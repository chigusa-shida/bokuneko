# ------------------------------------------------------------
# テストサーバー（サブドメイン test.bokuneko.jp）用の設定
#
# 【背景】
# 親ディレクトリ /bokuneko.jp/public_html/.htaccess に、旧サイトの
# PC/SP 振り分けルールが設定されている:
#
#   RewriteRule ^(.*)$ pc/$1 [L]   （PCのUAのとき）
#   RewriteRule ^(.*)$ sp/$1 [L]   （スマホのUAのとき）
#
# Xserverではサブドメインの公開ディレクトリが public_html の
# サブフォルダとして作られるため、この Rewrite が当サブドメインにも
# 継承され、/index.html が /pc/index.html へ書き換えられてしまう。
# サブドメイン配下に pc/・sp/ は無いので 404 になる。
#
# 【対処】
# 当サイトはCSSでレスポンシブ対応済みでUA振り分けは不要なため、
# このディレクトリ以下で継承された Rewrite を無効化する。
# 親の .htaccess は本番サイトが使用中のため絶対に変更しないこと。
#
# 【本番公開時】
# このファイル・robots.txt・各ページのnoindexメタは削除すること。
# ------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

DirectoryIndex index.html

# ------------------------------------------------------------
# キャッシュ制御（テストサーバ用）
#
# 【目的】
# 開発・更新中にスマホブラウザ（Safari/Chrome）で旧いCSS/JSが
# 残り、変更が反映されたりされなかったりする問題を防ぐ。
#
# 【方針】
# HTML・CSS・JS は「保存はするが毎回サーバへ更新確認（再検証）」する。
# 変更が無ければ 304 を返して高速、変更があれば最新を取得する。
# これにより、強制リロードをしなくても更新後に最新が読み込まれる。
#
# 【本番でCDN等を使う場合】
# 各ファイルには cache-bust.mjs が ?v=<バージョン> を付与しているため、
# 下記CSS/JSを長期キャッシュ（例: max-age=31536000）に変更しても、
# 更新時は ?v= が変わって自動的に最新へ切り替わる。
# ※このテスト用 .htaccess 自体は本番公開時に削除する想定。
# ------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
